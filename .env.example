# JSearch API (get from https://www.openwebninja.com/jsearch)
JSearch_API_name=x-api-key
JSearch_API_value=your_jsearch_api_key_here

# User database (MongoDB - for authentication and user settings)
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/
MONGO_DB_NAME=user_db

# Jobs database (MongoDB - for job listings and tracking)
JOBS_MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/
JOBS_DB_NAME=jobs_db
